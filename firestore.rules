rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      // Manter alinhado com VITE_ADMIN_EMAIL no frontend (não lê .env).
      return request.auth.token.email == 'admin@focusup.com';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || adminEmail());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || adminEmail());
      allow delete: if signedIn() && (request.auth.uid == userId || adminEmail());
    }

    match /dashboard/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /analytics_daily/{docId} {
      allow read: if signedIn() && adminEmail();
      allow create, update: if signedIn();
    }

    match /solicitacoes/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || adminEmail());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && adminEmail();
      allow delete: if adminEmail();
    }

    match /doacoes/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || adminEmail());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && adminEmail();
      allow delete: if adminEmail();
    }
  }
}
