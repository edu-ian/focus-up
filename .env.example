# Copie para .env na raiz do projeto (não commite .env).
# Valores usados em build (VITE_*) ficam expostos no bundle — são chaves públicas do Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail que recebe o painel administrativo (deve coincidir com a regra em firestore.rules).
VITE_ADMIN_EMAIL=admin@focusup.com
